# Alibaba Cloud Model Studio. Do not commit real values.
DASHSCOPE_API_KEY=
WORKSPACE_OPENAI_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
WORKSPACE_API_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com

# The CLI also loads ../.env and Default Workspace-apiKey-*.csv without copying
# or logging their secrets. WORKSPACE_API_BASE_URL is derived from the CSV's
# openAiCompatible URL when possible.

# Voice cloning is biometric processing. Set this only after the speaker has
# explicitly agreed to the clone for this session.
VOICE_CLONE_CONSENT_CONFIRMED=false

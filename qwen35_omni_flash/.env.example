# Optional overrides. By default the app reads ../.env and the exported
# ../Default Workspace-apiKey-*.csv without copying credentials here.
QWEN35_OMNI_MODEL=qwen3.5-omni-plus
QWEN35_OMNI_REALTIME_MODEL=qwen3.5-omni-flash-realtime
QWEN35_OMNI_SOURCE_LANGUAGE=auto-detect
QWEN35_OMNI_TARGET_LANGUAGE=English
QWEN35_OMNI_VOICE=Tina
# QWEN35_OMNI_BASE_URL=https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# QWEN35_OMNI_API_KEY=sk-ws-...
